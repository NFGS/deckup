{
  "name": "deckup",
  "version": "0.1.0",
  "private": true,
  "description": "Spaced-repetition flashcard platform for high school students preparing for final exams",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint scripts e2e playwright.config.ts",
    "typecheck": "turbo run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "turbo run test && vitest run",
    "test:scripts": "vitest run",
    "test:e2e": "pnpm build && playwright test",
    "sync:notion": "node --experimental-strip-types scripts/notion-sync.ts",
    "sync:obsidian": "node --experimental-strip-types scripts/obsidian-sync.ts",
    "sync:all": "node --experimental-strip-types scripts/sync-all.ts",
    "sync:check": "node --experimental-strip-types scripts/sync-check.ts",
    "sync:watch": "node --experimental-strip-types scripts/sync-watch.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.8",
    "railway": "^3.12.0",
    "turbo": "^2.11.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
