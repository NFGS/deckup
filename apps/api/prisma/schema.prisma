// DeckUp — Prisma schema
// Documentation: docs/02-architecture/data-model.md
// Migrations are immutable once applied (SPEC.md §4).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  ADMIN
}

enum DeckVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

enum CardDifficulty {
  EASY
  MEDIUM
  HARD
}

enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING
}

enum ReviewRating {
  AGAIN
  HARD
  GOOD
  EASY
}

enum SessionStatus {
  ACTIVE
  COMPLETED
  ABANDONED
}

enum SessionMode {
  DUE
  AHEAD
  ALL
}

model User {
  id           String   @id @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  displayName  String   @map("display_name")
  timezone     String   @default("UTC")
  role         UserRole @default(STUDENT)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  decks         Deck[]
  tags          Tag[]
  refreshTokens RefreshToken[]
  reviewStates  ReviewState[]
  reviewLogs    ReviewLog[]
  studySessions StudySession[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  familyId  String    @map("family_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Deck {
  id          String         @id @db.Uuid
  ownerId     String         @map("owner_id") @db.Uuid
  title       String
  description String?
  subject     String?
  color       String?
  visibility  DeckVisibility @default(PRIVATE)
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?      @map("deleted_at") @db.Timestamptz(3)

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  cards    Card[]
  deckTags DeckTag[]

  studySessions StudySession[]

  @@index([ownerId, deletedAt])
  @@index([ownerId, subject])
  @@index([visibility])
  @@map("decks")
}

model Tag {
  id        String   @id @db.Uuid
  ownerId   String   @map("owner_id") @db.Uuid
  name      String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  owner    User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  deckTags DeckTag[]
  cardTags CardTag[]

  @@unique([ownerId, name])
  @@map("tags")
}

model DeckTag {
  deckId String @map("deck_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  deck Deck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([deckId, tagId])
  @@map("deck_tags")
}

model Card {
  id            String          @id @db.Uuid
  deckId        String          @map("deck_id") @db.Uuid
  front         String
  back          String
  hint          String?
  imageUrl      String?         @map("image_url")
  imagePublicId String?         @map("image_public_id")
  difficulty    CardDifficulty?
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?       @map("deleted_at") @db.Timestamptz(3)

  deck     Deck      @relation(fields: [deckId], references: [id], onDelete: Cascade)
  cardTags CardTag[]

  reviewState ReviewState?
  reviewLogs  ReviewLog[]

  @@index([deckId, deletedAt])
  @@map("cards")
}

model CardTag {
  cardId String @map("card_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([cardId, tagId])
  @@map("card_tags")
}

model ReviewState {
  cardId           String    @id @map("card_id") @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  stability        Float     @default(0)
  difficulty       Float     @default(0)
  state            CardState @default(NEW)
  reps             Int       @default(0)
  lapses           Int       @default(0)
  scheduledDays    Int       @default(0) @map("scheduled_days")
  learningSteps    Int       @default(0) @map("learning_steps")
  lastReviewAt     DateTime? @map("last_review_at") @db.Timestamptz(3)
  dueAt            DateTime  @default(now()) @map("due_at") @db.Timestamptz(3)
  schedulerVersion String    @default("fsrs-6") @map("scheduler_version")
  version          Int       @default(0)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  card Card @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
  @@map("review_states")
}

model ReviewLog {
  id              String       @id @db.Uuid
  cardId          String       @map("card_id") @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  sessionId       String?      @map("session_id") @db.Uuid
  clientReviewId  String?      @map("client_review_id") @db.Uuid
  rating          ReviewRating
  reviewedAt      DateTime     @map("reviewed_at") @db.Timestamptz(3)
  elapsedMs       Int?         @map("elapsed_ms")
  scheduledDays   Int          @map("scheduled_days")
  previousDueAt   DateTime?    @map("previous_due_at") @db.Timestamptz(3)
  nextDueAt       DateTime     @map("next_due_at") @db.Timestamptz(3)
  stabilityAfter  Float        @map("stability_after")
  difficultyAfter Float        @map("difficulty_after")

  card    Card          @relation(fields: [cardId], references: [id], onDelete: Cascade)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  session StudySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@unique([sessionId, clientReviewId])
  @@index([cardId, reviewedAt])
  @@index([userId, reviewedAt])
  @@map("review_logs")
}

model StudySession {
  id            String        @id @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  deckId        String        @map("deck_id") @db.Uuid
  mode          SessionMode   @default(DUE)
  status        SessionStatus @default(ACTIVE)
  startedAt     DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt       DateTime?     @map("ended_at") @db.Timestamptz(3)
  cardsReviewed Int           @default(0) @map("cards_reviewed")
  correctCount  Int           @default(0) @map("correct_count")

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  deck Deck        @relation(fields: [deckId], references: [id], onDelete: Cascade)
  logs ReviewLog[]

  @@index([userId, startedAt])
  @@index([deckId, status])
  @@map("study_sessions")
}
