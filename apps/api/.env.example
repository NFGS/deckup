NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://deckup:deckup@localhost:5432/deckup?schema=public
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-0123456789
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# AI card generation (optional): provider 'openai' requires LLM_API_KEY
LLM_PROVIDER=disabled
# LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Card images (RF-05) — set IMAGE_STORAGE=cloudinary to enable uploads
IMAGE_STORAGE=disabled
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=deckup/cards

# Observability and proxy (NFR-07)
LOG_LEVEL=info
# Trusted reverse-proxy hops: "false" locally, "1" behind Railway/Vercel
TRUST_PROXY=false

# Demo seed account (pnpm --filter @deckup/api prisma:seed)
# SEED_EMAIL=demo@deckup.local
# SEED_PASSWORD=change-me-demo-password

# Integration tests (pnpm --filter @deckup/api test:e2e)
# TEST_DATABASE_URL=postgresql://deckup:deckup@localhost:5432/deckup_test?schema=public

# Alternative to the three CLOUDINARY_* variables below
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
